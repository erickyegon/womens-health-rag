# ─── LLM ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev  (docker-compose): postgresql://rag:rag@localhost:5432/rag
# Production: postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# ─── LangSmith observability ──────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=womens-health-rag

# ─── Reranking (Phase 2) ──────────────────────────────────────────────────────
COHERE_API_KEY=...

# ─── App ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=dev-secret-change-in-prod
LOG_LEVEL=INFO

# ─── RAG tuning ───────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
EMBEDDING_BATCH_SIZE=50
